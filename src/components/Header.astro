---
import { site } from '../data/site';
const links = site.nav.filter((item) => site.sections[item.section]);
---
<header class="header" id="site-header">
  <div class="container header__inner">
    <a class="brand" href="#top">
      <img class="brand__mark" src="/favicon.svg" alt="" width="32" height="32" />
      <span class="brand__name">{site.logo.text} <span>{site.logo.accent}</span></span>
    </a>
    <button class="nav__toggle" type="button" aria-expanded="false" aria-controls="primary-nav" id="nav-toggle">Menu</button>
    <nav class="nav" aria-label="Primary">
      <ul class="nav__list" id="primary-nav">
        {links.map((item) => (
          <li>
            <a class:list={['nav__link', { 'nav__cta': 'cta' in item && item.cta }]} href={item.href}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>
<script>
  const header = document.getElementById('site-header');
  const toggle = document.getElementById('nav-toggle');
  toggle?.addEventListener('click', () => {
    const open = header?.classList.toggle('nav-open');
    toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
  });
</script>
