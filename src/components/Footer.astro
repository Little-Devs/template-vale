---
import { site } from '../data/site';
const links = site.nav.filter((item) => site.sections[item.section]);
---
<footer class="footer">
  <div class="container">
    <div class="footer__grid">
      <div class="footer__brand">
        <a class="brand" href="#top">
          <img class="brand__mark" src="/favicon.svg" alt="" width="32" height="32" />
          <span class="brand__name">{site.logo.text} <span>{site.logo.accent}</span></span>
        </a>
        <p class="footer__tag">{site.footer.tag}</p>
      </div>
      <ul class="footer__nav">
        {links.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </div>
    <div class="footer__meta">
      <span>{site.footer.credit}</span>
    </div>
  </div>
</footer>
