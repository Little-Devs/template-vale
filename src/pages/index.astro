---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import Board from '../components/Board.astro';
import Lanes from '../components/Lanes.astro';
import Cargo from '../components/Cargo.astro';
import Terminals from '../components/Terminals.astro';
import Contact from '../components/Contact.astro';
import { site } from '../data/site';
---
<BaseLayout>
  <Header />
  <main id="main">
    {site.sections.hero && <Hero />}
    {site.sections.board && <Board />}
    {site.sections.lanes && <Lanes />}
    {site.sections.cargo && <Cargo />}
    {site.sections.terminals && <Terminals />}
    {site.sections.contact && <Contact />}
  </main>
  <Footer />
</BaseLayout>
